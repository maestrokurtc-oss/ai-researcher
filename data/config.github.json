    "twitter": {
      "enabled": false,
      "mode": "apify",
      "apify_token_env": "APIFY_TOKEN",
      "fetch_limit": 8,
      "fetch_reply_text": false,
      "category": "social",
      "profile": "tech-news",
      "users": [
        "sama",
        "AnthropicAI",
        "OpenAI",
        "GoogleDeepMind",
        "ylecun",
        "karpathy",
        "_jasonwei",
        "DrJimFan",
        "swyx",
        "alexalbert__",
        "rasbt",
        "_philschmid"
      ]
    },
    "google_news": {
      "enabled": true,
      "query": "artificial intelligence OR LLM OR \"AI model\" announcement",
      "language": "en",
      "country": "US",
      "max_results": 60,
      "category": "industry",
      "profile": "tech-news"
    },
    "telegram": {
      "enabled": false,
      "channels": []
    }
  },
  "collection": {
    "time_window_hours": 13
  },
  "digest": {
    "max_items": 24,
    "profile_order": [
      "tech-news",
      "ai-paper",
      "tech-blog"
    ],
    "category_groups": {},
    "default_group": "other",
    "default_group_limit": null
  },
  "webhook": {
    "enabled": false,
    "url_env": "HORIZON_WEBHOOK_URL",
    "delivery": "summary",
    "platform": "generic",
    "layout": "markdown",
    "languages": [
      "ko"
    ]
  }
