{
  "ai": {
    "provider": "anthropic",
    "model": "claude-sonnet-5",
    "api_key_env": "ANTHROPIC_API_KEY",
    "temperature": 0.3,
    "max_tokens": 8192,
    "throttle_sec": 0.5,
    "analysis_concurrency": 4,
    "enrichment_concurrency": 3,
    "languages": [
      "ko"
    ],
    "stage_models": {
      "analysis": "claude-haiku-4-5",
      "dedup": "claude-haiku-4-5"
    }
  },
  "processing": {
    "profiles_dir": "profiles",
    "default_profile": "tech-news",
    "profile_settings": {
      "ai-paper": {
        "threshold": 7.5,
        "topic_dedup": true
      },
      "tech-news": {
        "threshold": 7.0,
        "topic_dedup": true
      },
      "tech-blog": {
        "threshold": 6.0,
        "topic_dedup": false
      }
    }
  },
  "sources": {
    "arxiv": {
      "enabled": true,
      "categories": [
        "cs.AI",
        "cs.CL",
        "cs.LG",
        "cs.CV",
        "cs.MA",
        "stat.ML"
      ],
      "max_results_per_category": 80,
      "request_delay_sec": 3.0,
      "category": "ai-research",
      "profile": "ai-paper",
      "boost_keywords": [
        "agent",
        "reasoning",
        "reinforcement learning",
        "benchmark",
        "scaling",
        "interpretability",
        "alignment",
        "multimodal",
        "retrieval",
        "long context",
        "distillation",
        "mixture of experts",
        "world model",
        "evaluation",
        "chain of thought",
        "post-training",
        "inference"
      ]
    },
    "hackernews": {
      "enabled": true,
      "fetch_top_stories": 40,
      "min_score": 80,
      "category": "community",
      "profile": "tech-news"
    },
    "reddit": {
      "enabled": true,
      "fetch_comments": 8,
      "users": [],
      "subreddits": [
        {
          "subreddit": "MachineLearning",
          "sort": "hot",
          "time_filter": "day",
          "fetch_limit": 15,
          "min_score": 60,
          "category": "community",
          "profile": "tech-news"
        },
        {
          "subreddit": "LocalLLaMA",
          "sort": "hot",
          "time_filter": "day",
          "fetch_limit": 15,
          "min_score": 60,
          "category": "community",
          "profile": "tech-news"
        },
        {
          "subreddit": "singularity",
          "sort": "hot",
          "time_filter": "day",
          "fetch_limit": 10,
          "min_score": 200,
          "category": "community",
          "profile": "tech-news"
        },
        {
          "subreddit": "OpenAI",
          "sort": "hot",
          "time_filter": "day",
          "fetch_limit": 10,
          "min_score": 120,
          "category": "community",
          "profile": "tech-news"
        },
        {
          "subreddit": "ClaudeAI",
          "sort": "hot",
          "time_filter": "day",
          "fetch_limit": 10,
          "min_score": 80,
          "category": "community",
          "profile": "tech-news"
        }
      ]
    },
    "github": [
